# Included by CMakeLists, edited by the build script
# (the version numbers are generated by the build script from the git current label)

# Fork branding. SLIC3R_APP_NAME is the name users see and the name of the settings
# folder, so this build installs next to official PrusaSlicer without sharing its
# settings. SLIC3R_APP_KEY intentionally stays "PrusaSlicer": it is written into 3MF
# projects and names the translation catalogs, and G-code files keep the
# "generated by PrusaSlicer" header, so files stay compatible both ways.
set(SLIC3R_APP_NAME "PrusSLASlicer")
set(SLIC3R_APP_KEY "PrusaSlicer")
set(SLIC3R_BUNDLE_ID "com.paenian.prusslaslicer")
set(SLIC3R_VERSION "2.9.7")
# Release builds pass -DSLIC3R_BUILD_LABEL=<label> (e.g. "sla.1"); local builds show "+UNKNOWN".
if (NOT DEFINED SLIC3R_BUILD_LABEL OR SLIC3R_BUILD_LABEL STREQUAL "")
    set(SLIC3R_BUILD_LABEL "UNKNOWN")
endif ()
set(SLIC3R_BUILD_ID "${SLIC3R_APP_NAME}-${SLIC3R_VERSION}+${SLIC3R_BUILD_LABEL}")
set(SLIC3R_RC_VERSION "2,9,7,0")
set(SLIC3R_RC_VERSION_DOTS "2.9.7.0")
